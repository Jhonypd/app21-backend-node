generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Pessoa {
  id                      String               @id @default(uuid())
  nome                    String
  email                   String               @unique
  inativo                 Boolean              @default(false)
  data_criacao            DateTime             @default(now())
  senha                   String
  email_confirmado        Boolean              @default(false)
  email_hash              String               @unique
  codigo_confirmacao      String?              @unique
  codigo_expiracao        DateTime?
  codigo_confirmacao_hash String?              @unique
  email_busca             String               @default("")
  nome_busca              String               @default("")
  participacoes           ParticipanteSala[]
  participantes_sessao    ParticipanteSessao[]
  salas_criadas           Sala[]               @relation("SalasCriadasPorPessoa")
  sessao_usuario          SessaoPessoa[]
  sessoes_iniciadas       SessaoSala[]         @relation("SessoesIniciadas")
  votos                   Voto[]

  @@index([email])
  @@index([codigo_expiracao])
  @@index([nome_busca])
  @@index([email_busca])
}

model Sala {
  id                String             @id @default(uuid())
  codigo            String             @unique
  titulo            String
  criado_por        String
  senha             String?
  inativo           Boolean            @default(false)
  data_criacao      DateTime           @default(now())
  data_alteracao    DateTime?
  historia_atual_id String?
  votos_revelados   Boolean            @default(false)
  historias         HistoriaSala[]
  participantes     ParticipanteSala[]
  proprietario      Pessoa             @relation("SalasCriadasPorPessoa", fields: [criado_por], references: [id])
  sessoes           SessaoSala[]

  @@index([criado_por])
  @@index([codigo])
  @@index([historia_atual_id])
}

model HistoriaSala {
  id              String           @id @default(uuid())
  sala_id         String
  titulo          String
  descricao       String?
  criado_por      String
  data_criacao    DateTime         @default(now())
  sala            Sala             @relation(fields: [sala_id], references: [id])
  historia_sessao HistoriaSessao[]

  @@index([sala_id])
}

model ParticipanteSala {
  id         String   @id @default(uuid())
  sala_id    String
  pessoa_id  String
  adicionado DateTime @default(now())
  online     Boolean  @default(false)
  role       Int      @default(2)
  pessoa     Pessoa   @relation(fields: [pessoa_id], references: [id])
  sala       Sala     @relation(fields: [sala_id], references: [id])

  @@unique([sala_id, pessoa_id])
  @@index([sala_id])
  @@index([pessoa_id])
  @@index([role])
}

model SessaoSala {
  id                String               @id @default(uuid())
  sala_id           String
  criada_em         DateTime             @default(now())
  ativa             Boolean              @default(true)
  iniciada_por      String
  data_encerramento DateTime?
  encerrada_por     String?
  historias         HistoriaSessao[]
  participantes     ParticipanteSessao[]
  iniciador         Pessoa               @relation("SessoesIniciadas", fields: [iniciada_por], references: [id])
  sala              Sala                 @relation(fields: [sala_id], references: [id])

  @@index([sala_id])
  @@index([iniciada_por])
}

model ParticipanteSessao {
  id                String     @id @default(uuid())
  sessao_id         String
  pessoa_id         String
  autorizado        Boolean    @default(false)
  participa_votacao Boolean    @default(true)
  online            Boolean    @default(false)
  pessoa            Pessoa     @relation(fields: [pessoa_id], references: [id])
  sessao            SessaoSala @relation(fields: [sessao_id], references: [id])

  @@unique([sessao_id, pessoa_id])
  @@index([sessao_id])
  @@index([pessoa_id])
}

model HistoriaSessao {
  id          String       @id @default(uuid())
  sessao_id   String
  historia_id String
  ordem       Int          @default(0)
  historia    HistoriaSala @relation(fields: [historia_id], references: [id])
  sessao      SessaoSala   @relation(fields: [sessao_id], references: [id])
  votos       Voto[]

  @@unique([sessao_id, historia_id])
  @@index([sessao_id])
  @@index([historia_id])
}

model Voto {
  id                 String         @id @default(uuid())
  pessoa_id          String
  valor              Int
  data_voto          DateTime       @default(now())
  historia_sessao_id String
  historiaSessao     HistoriaSessao @relation(fields: [historia_sessao_id], references: [id])
  pessoa             Pessoa         @relation(fields: [pessoa_id], references: [id])

  @@unique([historia_sessao_id, pessoa_id])
  @@index([historia_sessao_id])
  @@index([pessoa_id])
}

model RefreshToken {
  id          String       @id @default(uuid())
  expiracao   DateTime
  criado_em   DateTime     @default(now())
  revogado_em DateTime?
  sessao_id   String       @unique
  token_hash  String       @unique
  sessao      SessaoPessoa @relation(fields: [sessao_id], references: [id])
}

model SessaoPessoa {
  id               String        @id @default(uuid())
  pessoa_id        String
  criado_em        DateTime      @default(now())
  expiracao        DateTime
  ultimo_acesso_em DateTime      @default(now())
  revogado_em      DateTime?
  ip               String?
  user_agent       String?
  refreshToken     RefreshToken?
  pessoa           Pessoa        @relation(fields: [pessoa_id], references: [id])

  @@index([pessoa_id])
}
