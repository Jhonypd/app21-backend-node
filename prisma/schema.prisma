generator client {
  provider = "prisma-client-js"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pessoa {
  id                      String             @id @default(uuid())
  nome                    String
  email                   String             @unique
  email_hash              String             @unique
  email_confirmado        Boolean            @default(false)
  codigo_confirmacao      String?            @unique
  codigo_confirmacao_hash String?            @unique
  codigo_expiracao        DateTime?
  senha                   String
  inativo                 Boolean            @default(false)
  data_criacao            DateTime           @default(now())
  participacoes           ParticipanteSala[]
  salasCriadas            Sala[]             @relation("SalasCriadasPorPessoa")
  votos                   Voto[]
  refreshTokens           RefreshToken[]
  sessaoUsuarios          SessaoUsuario[]

  @@index([email])
  @@index([codigo_expiracao])
}

model Sala {
  id             String             @id @default(uuid())
  codigo         String             @unique
  titulo         String
  criado_por     String
  senha          String?
  inativo        Boolean            @default(false)
  data_criacao   DateTime           @default(now())
  data_alteracao DateTime?
  participantes  ParticipanteSala[]
  proprietario   Pessoa             @relation("SalasCriadasPorPessoa", fields: [criado_por], references: [id])
  votos          Voto[]
  historias      HistoriaSala[]

  @@index([criado_por])
  @@index([codigo])
}

model HistoriaSala {
  id           String   @id @default(uuid())
  sala_id      String
  titulo       String
  descricao    String?
  criado_por   String
  data_criacao DateTime @default(now())
  sala         Sala     @relation(fields: [sala_id], references: [id])
}

model ParticipanteSala {
  id         String   @id @default(uuid())
  sala_id    String
  pessoa_id  String
  adicionado DateTime @default(now())
  pessoa     Pessoa   @relation(fields: [pessoa_id], references: [id])
  sala       Sala     @relation(fields: [sala_id], references: [id])

  @@unique([sala_id, pessoa_id])
  @@index([sala_id])
  @@index([pessoa_id])
}

model Voto {
  id          String   @id @default(uuid())
  pessoa_id   String
  sala_id     String
  historia_id String
  valor       Int
  data_voto   DateTime @default(now())
  pessoa      Pessoa   @relation(fields: [pessoa_id], references: [id])
  sala        Sala     @relation(fields: [sala_id], references: [id])

  @@unique([sala_id, pessoa_id, historia_id])
  @@index([sala_id, pessoa_id, historia_id])
  @@index([sala_id])
  @@index([pessoa_id])
}

model RefreshToken {
  id          String    @id @default(uuid())
  token       String    @unique
  userId      String
  usuario     Pessoa    @relation(fields: [userId], references: [id])
  expiracao   DateTime
  criado_em   DateTime  @default(now())
  revogado_em DateTime?

  @@index([userId])
}

model SessaoUsuario {
  id          String    @id @default(uuid())
  usuario_id  String
  criado_em   DateTime  @default(now())
  expiracao   DateTime
  revogado_em DateTime?

  usuario Pessoa @relation(fields: [usuario_id], references: [id])
}
